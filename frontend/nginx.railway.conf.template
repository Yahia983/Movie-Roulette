# Template for the Railway frontend deployment — see Dockerfile and
# docker-entrypoint-railway.sh. ${PORT} is substituted at container start
# (Railway assigns this dynamically; it's not known at image build time).
# No API proxy block here — see js/config.js and the Dockerfile's comment
# for why this deployment path uses cross-origin CORS calls instead.

server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

    gzip on;
    gzip_comp_level 6;
    gzip_min_length 512;
    gzip_types text/css application/javascript text/javascript application/json image/svg+xml;

    location ~* \.(?:css|js|svg|png|jpg|jpeg|webp|ico)$ {
        add_header Cache-Control "public, max-age=3600, must-revalidate";
    }

    location / {
        try_files $uri $uri/ =404;
    }

    location /healthz {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }
}
