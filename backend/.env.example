# Copy this file to `.env` and fill in real values for your environment.
# Never commit the real `.env` file.

# --- Core ---
PROJECT_NAME=MovieRoulette
ENVIRONMENT=development
DEBUG=true

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=dev-only-insecure-secret-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Database ---
DATABASE_URL=postgresql+asyncpg://movieroulette:movieroulette@localhost:5432/movieroulette
DATABASE_URL_SYNC=postgresql+psycopg2://movieroulette:movieroulette@localhost:5432/movieroulette
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
CACHE_DEFAULT_TTL_SECONDS=300

# --- CORS (comma-separated list, parsed as JSON array by pydantic-settings) ---
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- External services ---
TMDB_API_KEY=
